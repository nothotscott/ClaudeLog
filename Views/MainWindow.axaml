<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ClaudeLog.ViewModels"
        xmlns:ae="using:AvaloniaEdit"
        xmlns:ed="using:ClaudeLog.Views.Editing"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="ClaudeLog.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ClaudeLog"
        Width="1280" Height="820"
        MinWidth="900" MinHeight="560">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveEditorCommand}" />
    <!-- Ctrl+Enter sends. Copy keeps a binding for the prompts that are going somewhere
         ClaudeLog didn't start, but it is no longer the default way out of the editor. -->
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SendPromptCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Enter" Command="{Binding CopyPromptCommand}" />
    <KeyBinding Gesture="Ctrl+T" Command="{Binding StartTerminalCommand}" />
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewPromptCommand}" />
    <KeyBinding Gesture="Ctrl+Q" Command="{Binding QueuePromptCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding RefreshTreeCommand}" />
  </Window.KeyBindings>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Header -->
    <Border Grid.Row="0" Padding="12,8" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="ClaudeLog" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Text="{Binding LogRoot}" Classes="dim" FontSize="12" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
          <Button Content="Log folder" Command="{Binding OpenLogRootCommand}" />
          <Button Content="Refresh" Command="{Binding RefreshTreeCommand}" />
          <Button Content="settings.json" Command="{Binding OpenSettingsFileCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Three panes -->
    <Grid Grid.Row="1" ColumnDefinitions="300,5,*,5,320">

      <!-- Projects and sessions -->
      <TreeView Grid.Column="0" ItemsSource="{Binding Tree}" SelectedItem="{Binding SelectedNode}"
                Margin="4" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <TreeView.ItemTemplate>
          <TreeDataTemplate ItemsSource="{Binding Children}" DataType="vm:TreeNodeViewModel">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Height="26">
              <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="11" Margin="0,0,6,0"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="dim" FontSize="10"
                         Margin="6,0,4,0" MinWidth="38" TextAlignment="Right"
                         VerticalAlignment="Center" />
              <!-- The shortcut into Examples/ and Plans/ — always reachable, never clipped. -->
              <Button Grid.Column="3" Content="&#x29C9;" FontSize="11" Padding="4,0" Margin="4,0,2,0"
                      Background="Transparent" BorderThickness="0"
                      IsVisible="{Binding IsFolder}"
                      ToolTip.Tip="Open this folder in Explorer"
                      Command="{Binding OpenInExplorerCommand}" />
            </Grid>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>

        <TreeView.Styles>
          <Style Selector="TreeViewItem" x:DataType="vm:TreeNodeViewModel">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <!-- Everything file-level lives here. A ContextMenu is its own popup tree, so these
                 bind to commands on the node itself — nothing inside can reach the window's view
                 model by walking up the visual tree. -->
            <Setter Property="ContextMenu">
              <Template>
                <ContextMenu>
                  <MenuItem Header="New session…" Command="{Binding NewSessionCommand}"
                            IsVisible="{Binding CanAddSession}" />
                  <MenuItem Header="Rename…" Command="{Binding RenameSessionCommand}"
                            IsVisible="{Binding IsSession}" />
                  <Separator IsVisible="{Binding CanAddSession}" />

                  <MenuItem Header="Open in Explorer" Command="{Binding OpenInExplorerCommand}" />

                  <Separator IsVisible="{Binding IsSession}" />
                  <MenuItem Header="Split on blank lines (legacy)" IsVisible="{Binding IsSession}"
                            Command="{Binding UseLegacyModeCommand}" />
                  <MenuItem Header="Split on --- separators" IsVisible="{Binding IsSession}"
                            Command="{Binding UseModernModeCommand}" />
                  <MenuItem Header="Convert file to --- separators" IsVisible="{Binding IsSession}"
                            Command="{Binding ConvertToModernCommand}" />
                </ContextMenu>
              </Template>
            </Setter>
          </Style>
        </TreeView.Styles>
      </TreeView>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

      <!-- Session: prompts on top, editor below -->
      <!-- The prompt list now carries the whole file, so it gets the larger share; the splitter moves it. -->
      <Grid Grid.Column="2" RowDefinitions="Auto,3*,5,2*" Margin="4">

        <StackPanel Grid.Row="0" Spacing="6" Margin="4,4,4,8">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="{Binding SessionTitle}" FontSize="15" FontWeight="SemiBold" />
              <TextBlock Text="{Binding SessionSubtitle}" Classes="dim" FontSize="11"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                        IsVisible="{Binding HasSession}">
              <!--
                The terminal control is one button, because there is only ever one thing to do with
                it: start it when it isn't running, bring it forward when it is. Everything rarer —
                a fresh conversation, a different working directory — is on its context menu.
              -->
              <Button Command="{Binding StartTerminalCommand}"
                      IsEnabled="{Binding !TerminalBusy}"
                      ToolTip.Tip="{Binding TerminalTooltip}">
                <TextBlock Text="{Binding TerminalLabel}" FontSize="12" />
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Show terminal" Command="{Binding ShowTerminalCommand}" />
                    <MenuItem Header="New Claude session" Command="{Binding NewClaudeSessionCommand}" />
                    <Separator />
                    <MenuItem Header="Session directory…" Command="{Binding ChangeSessionDirCommand}" />
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
              <!-- Splitting and converting moved to the file's context menu in the tree: they are
                   per-file, and they come up once in the life of a file, not once a session. -->
              <Button Content="New prompt" Command="{Binding NewPromptCommand}"
                      ToolTip.Tip="Ctrl+N" />
            </StackPanel>
          </Grid>

          <!-- Explorer shortcuts: project folder, then Examples/Plans and any other subfolder -->
          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasSession}">
            <TextBlock Text="Open:" Classes="dim" FontSize="11" VerticalAlignment="Center" />
            <ItemsControl ItemsSource="{Binding Shortcuts}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:TreeNodeViewModel">
                  <Button Command="{Binding OpenInExplorerCommand}" Padding="8,3" FontSize="11">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <TextBlock Text="{Binding Icon}" FontSize="10" />
                      <TextBlock Text="{Binding Name}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="&#x1F4C4; this file" Padding="8,3" FontSize="11"
                    Command="{Binding RevealSessionCommand}"
                    ToolTip.Tip="Show this session file in Explorer" />
            <Button Content="&#x1F4BB; source" Padding="8,3" FontSize="11"
                    Command="{Binding OpenProjectSourceCommand}"
                    ToolTip.Tip="Open the project's source folder" />
          </StackPanel>
        </StackPanel>

        <!--
          Each prompt is shown whole rather than as a one-line preview, so the pane reads like the
          session file itself. Virtualization is off deliberately: item heights here range from one
          line to seventy, and the largest file in the tree holds 51 prompts — a plain StackPanel
          measures them all and gets the scrollbar exactly right, which the estimating virtualizer
          cannot.
        -->
        <ListBox Grid.Row="1" x:Name="PromptList" ItemsSource="{Binding Prompts}"
                 SelectedItem="{Binding SelectedPrompt}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.Styles>
            <!-- A hairline under each prompt does the job the old "12 lines" caption used to do:
                 say where one prompt ends. The line count itself is redundant now that the text
                 is all there. -->
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="8,7" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="VerticalContentAlignment" Value="Top" />
              <Setter Property="BorderThickness" Value="0,0,0,1" />
              <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:PromptViewModel">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding Number}" Classes="dim"
                           FontSize="11" Width="24" TextAlignment="Right" Margin="0,2,8,0"
                           VerticalAlignment="Top" />
                <ed:MarkdownBlock Grid.Column="1" Source="{Binding Text}" TextWrapping="Wrap"
                                  FontFamily="Cascadia Mono,Consolas,Menlo,monospace" FontSize="13" />
                <Border Grid.Column="2" Classes="pill" Background="{Binding StatusBrush}"
                        IsVisible="{Binding ShowStatus}" Margin="8,0" VerticalAlignment="Top">
                  <TextBlock Text="{Binding StatusLabel}" FontSize="10" Foreground="White" />
                </Border>
                <Button Grid.Column="3" Content="Send" FontSize="11" Padding="8,2"
                        VerticalAlignment="Top" Classes="accent"
                        ToolTip.Tip="Send straight to this session's Claude Code (Ctrl+Enter)"
                        Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).SendPromptCommand}"
                        CommandParameter="{Binding}" />
                <Button Grid.Column="4" Content="Copy" FontSize="11" Padding="8,2"
                        Margin="4,0,0,0" VerticalAlignment="Top"
                        ToolTip.Tip="Copy to clipboard and mark sent (Ctrl+Shift+Enter)"
                        Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).CopyPromptCommand}"
                        CommandParameter="{Binding}" />
                <Button Grid.Column="5" Content="Queue" FontSize="11" Padding="8,2"
                        Margin="4,0,0,0" VerticalAlignment="Top"
                        ToolTip.Tip="Send when the limit resets (Ctrl+Q)"
                        Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).QueuePromptCommand}"
                        CommandParameter="{Binding}" />
                <Grid.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Toggle sent"
                              Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).ToggleSentCommand}"
                              CommandParameter="{Binding}" />
                    <MenuItem Header="Merge with next"
                              Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).MergeWithNextCommand}"
                              CommandParameter="{Binding}" />
                    <Separator />
                    <MenuItem Header="Delete prompt"
                              Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).DeletePromptCommand}"
                              CommandParameter="{Binding}" />
                  </ContextMenu>
                </Grid.ContextMenu>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <GridSplitter Grid.Row="2" ResizeDirection="Rows" Background="Transparent" />

        <Grid Grid.Row="3" RowDefinitions="Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="2,6,2,4">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding EditorHeader}" Classes="h" VerticalAlignment="Center" />
              <TextBlock Text="unsaved" Classes="dim" FontSize="11" VerticalAlignment="Center"
                         IsVisible="{Binding IsDirty}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <Button Content="Save" Command="{Binding SaveEditorCommand}" ToolTip.Tip="Ctrl+S" />
              <Button Content="Copy" Command="{Binding CopyPromptCommand}" ToolTip.Tip="Ctrl+Shift+Enter" />
              <Button Content="Send" Classes="accent" Command="{Binding SendPromptCommand}"
                      ToolTip.Tip="Ctrl+Enter" />
            </StackPanel>
          </Grid>

          <Border Grid.Row="1" BorderThickness="1" CornerRadius="3"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                  Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
            <ae:TextEditor x:Name="Editor"
                           WordWrap="True"
                           ShowLineNumbers="False"
                           FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
                           FontSize="13"
                           Padding="8,6"
                           HorizontalScrollBarVisibility="Disabled"
                           VerticalScrollBarVisibility="Auto" />
          </Border>
        </Grid>
      </Grid>

      <GridSplitter Grid.Column="3" ResizeDirection="Columns" Background="Transparent" />

      <!-- Queue and reset countdown -->
      <Grid Grid.Column="4" RowDefinitions="Auto,Auto,*" Margin="4,8,8,4">

        <Border Grid.Row="0" Padding="12" CornerRadius="6" BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
          <Border.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Set the reset time manually" ToggleType="CheckBox"
                        IsChecked="{Binding ShowManualReset, Mode=TwoWay}" />
            </ContextMenu>
          </Border.ContextMenu>

          <StackPanel Spacing="4">
            <TextBlock Text="SESSION LIMIT" Classes="h" />
            <TextBlock Text="{Binding CountdownText}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ResetDetail}" Classes="dim" FontSize="11" TextWrapping="Wrap" />

            <!-- Five-hour session usage, from UsageWatcher. Hidden until the first successful poll,
                 same "degrade to nothing rather than a wrong number" rule as everything else here. -->
            <ProgressBar Margin="0,6,0,0" Height="6" Minimum="0" Maximum="100"
                         Value="{Binding SessionUsagePercent}"
                         IsVisible="{Binding HasSessionUsage}" />

            <!-- Weekly usage, same source, shown only once it's actually meaningful next to the
                 session bar above. -->
            <StackPanel Spacing="2" Margin="0,6,0,0" IsVisible="{Binding HasWeeklyUsage}">
              <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding WeeklyUsagePercent}" />
              <TextBlock Text="{Binding WeeklyUsageDetail}" Classes="dim" FontSize="10" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Hidden unless asked for, or unless an override is set — see ManualResetVisible. -->
            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0"
                  IsVisible="{Binding ManualResetVisible}">
              <TextBox Grid.Column="0" Text="{Binding ManualResetInput}" PlaceholderText="9pm"
                       FontSize="11" Height="26" Padding="6,2" />
              <Button Grid.Column="1" Content="Set" FontSize="11" Padding="8,2" Margin="4,0,0,0"
                      Command="{Binding SetManualResetCommand}" />
              <Button Grid.Column="2" Content="Clear" FontSize="11" Padding="8,2" Margin="4,0,0,0"
                      Command="{Binding ClearManualResetCommand}" />
            </Grid>
          </StackPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="2,14,2,6">
          <TextBlock Grid.Column="0" Text="QUEUE" Classes="h" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Copy next" FontSize="11" Padding="8,2"
                  IsEnabled="{Binding HasQueue}"
                  Command="{Binding CopyNextQueuedCommand}" />
          <Button Grid.Column="2" Content="Send next" FontSize="11" Padding="8,2" Margin="4,0,0,0"
                  Classes="accent" IsEnabled="{Binding HasQueue}"
                  ToolTip.Tip="Send the head of the queue to the open session's terminal"
                  Command="{Binding SendNextQueuedCommand}" />
        </Grid>

        <ListBox Grid.Row="2" ItemsSource="{Binding Queue}">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:QueueItemViewModel">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,2">
                <StackPanel Grid.Column="0" Spacing="1">
                  <TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis" FontSize="12" />
                  <TextBlock Text="{Binding Location}" Classes="dim" FontSize="10" />
                </StackPanel>
                <Button Grid.Column="1" Content="&#x25B2;" FontSize="9" Padding="5,1"
                        Background="Transparent" BorderThickness="0"
                        Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).QueueUpCommand}"
                        CommandParameter="{Binding}" />
                <Button Grid.Column="2" Content="&#x25BC;" FontSize="9" Padding="5,1"
                        Background="Transparent" BorderThickness="0"
                        Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).QueueDownCommand}"
                        CommandParameter="{Binding}" />
                <Button Grid.Column="3" Content="&#x2715;" FontSize="10" Padding="5,1"
                        Background="Transparent" BorderThickness="0"
                        ToolTip.Tip="Remove from queue"
                        Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).UnqueueCommand}"
                        CommandParameter="{Binding}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="2" Padding="12,6" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <TextBlock Text="{Binding Status}" FontSize="11" Classes="dim" />
    </Border>
  </Grid>
</Window>
