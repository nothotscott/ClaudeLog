<?xml version="1.0" encoding="utf-8"?>
<!--
  The machine-wide NuGet.config is an explicit package-source allowlist (it exists for the work
  GitLab feeds). Rather than editing that global file to add one package, this repo scopes itself
  to nuget.org, the same way CallTree does.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
